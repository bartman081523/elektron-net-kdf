.vscode
cmake-build-debug

# Ignoring the Dockerfile allows us to change it without invalidating the "COPY ." step.
/Dockerfile

!/target/release/mm2
!/target/debug/mm2
!/target/release/kdf
!/target/debug/kdf
/mm2src/*/target

/build
/x64
/marketmaker_depends

/js/node_modules
/js/*.dll
/js/*.wasm
/js/mm2
/js/mm2.exe
/js/kdf
/js/kdf.exe
/wasm-build.log

# Opt out from history in order to speed the `COPY .` up.
/.git

# --- elektron-net marketplace image (repo-root Dockerfile) -----------------
# The image copies only Cargo files, mm2src, coins, web and docker, so keep
# everything else out of the context (size and secret hygiene).
/doc
/docs
/examples
/scripts
/deploy
/scratches
/.github
/.vscode
/cmake-build-debug
/x64
/build
/marketmaker_depends
/js
__pycache__
*.log
*.mm2.log
*.mm2.json
*.tar
*.zip
