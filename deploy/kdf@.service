[Unit]
Description=kdf (Komodo DeFi Framework, Elektron Net fork, instance %i)
After=network-online.target
Wants=network-online.target

[Service]
# per-instance EnvironmentFile: ~/.config/kdf/%i.env defines
# RUST_LOG, MM_LOG, MM_COINS_PATH, MM_CONF_PATH
# NB: systemd does not expand ${VAR} in the ExecStart executable path,
# so the binary lives at a fixed specifier-resolved location. Install it
# with: install -m0755 <release-dir>/kdf ~/.local/bin/kdf
EnvironmentFile=%h/.config/kdf/%i.env
ExecStart=%h/.local/bin/kdf
Restart=always
RestartSec=10

[Install]
WantedBy=default.target