# elek-web instance environment (systemd EnvironmentFile)
# Copy to ~/.config/kdf/web.env and adapt the paths, then start the unit:
#   cp deploy/elek-web@.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user start elek-web@web
#
# MM_WEB_ROOT must point at the fork checkout's web/ directory (absolute).
# MM_WEB_ADDR default is 127.0.0.1:3000 — browse the UI exactly as
# http://localhost:3000 so the browser's Origin matches the daemon's
# `rpccors` value (single string, default "http://localhost:3000"; browsing
# as http://127.0.0.1:3000 would NOT match and the JSON-RPC would fail its
# CORS preflight).

MM_WEB_ROOT=/run/media/julian/ML3/elektron-net/artifacts/komodo-defi-framework/web
MM_WEB_ADDR=127.0.0.1:3000

# Auto-connect (optional pair): when BOTH are set, elek-web serves the pair
# at /elek-web-config.json and the SPA connects at boot without the connect
# form. MM_WEB_RPC_PASS is the daemon's rpc_password (same value as the
# rpc_password in that daemon's MM2.json). Trust: this hands the rpc
# password to every browser that can reach elek-web — keep the bind on
# loopback and the port closed in nftables; tunnels stay inside your auth.
# Without the pair the endpoint answers 404 and the SPA shows the connect
# form as before.
# MM_WEB_RPC_URL=http://127.0.0.1:7795
# MM_WEB_RPC_PASS=<rpc_password of that daemon>

# Unified price estimate (doc/elektron.md §13): electrs derives the ELEK rate
# (P2P market > registry reference > mining cost floor) and writes the
# rich-shape file; elek-web serves it same-origin at /fx/rates.json so the SPA
# shows one rate everywhere. Set MM_WEB_FX_RATES to that electrs
# fx_rates_path value. Unset or missing file -> /fx/rates.json is a 404 and
# the SPA hides the rate line (nothing is fabricated at the web layer).
# MM_WEB_FX_RATES=/run/media/julian/ML3/elektron-net/elektron-net-electrs/fx-rates.json