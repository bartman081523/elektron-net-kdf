# elek-web instance environment (systemd EnvironmentFile)
# Copy to ~/.config/kdf/web.env and adapt the paths, then start the unit:
#   cp deploy/elek-web@.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user start elek-web@web
#
# MM_WEB_ROOT must point at the fork checkout's web/ directory (absolute).
# MM_WEB_ADDR default is 127.0.0.1:3000 — browse the UI exactly as
# http://localhost:3000 so the browser's Origin matches the daemon's
# `rpccors` value (single string, default "http://localhost:3000"; browsing
# as http://127.0.0.1:3000 would NOT match and the JSON-RPC would fail its
# CORS preflight).

MM_WEB_ROOT=/run/media/julian/ML3/elektron-net/artifacts/komodo-defi-framework/web
MM_WEB_ADDR=127.0.0.1:3000