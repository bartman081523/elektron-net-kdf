# kdf instance environment (systemd EnvironmentFile)
# Copy to ~/.config/kdf/<instance>.env and adapt every path.
# Absolute paths only: systemd does not expand variables inside
# EnvironmentFile values.

RUST_LOG=info

# The unit runs %h/.local/bin/kdf: systemd does not expand ${VAR} in the
# ExecStart executable path (verified live, status 203/EXEC). Build with
#   cd <fork checkout> && CARGO_TARGET_DIR=<dir> cargo build --workspace
# and install: install -m0755 <dir>/release/kdf ~/.local/bin/kdf

# merged coins file produced by scripts/elektron/coins_merge.py
MM_COINS_PATH=/run/media/julian/ML3/elektron-net/artifacts/komodo-defi-framework/coins/elektron_coins

# instance log file (kdf logs to file, journald sees only stdout)
MM_LOG=/home/<user>/.local/share/kdf/<instance>/kdf.log

# machine-local MM2.json: holds the seed phrase + rpc password.
# NEVER commit it; keep it outside any repository checkout.
MM_CONF_PATH=/home/<user>/.local/share/kdf/<instance>/MM2.json